{
  "name": "pos-hardware-bridge",
  "version": "1.0.1",
  "private": true,
  "description": "Print receipts, kitchen tickets and A4 invoices from any POS — web, desktop or mobile — on any ESC/POS or Star thermal printer. A tray app with a local HTTP API, SDK and print-station protocol.",
  "license": "MIT",
  "homepage": "https://thisarahetz.github.io/pos-hardware-bridge/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thisarahetz/pos-hardware-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Thisarahetz/pos-hardware-bridge/issues"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "receipt-printer",
    "thermal-printer",
    "escpos",
    "star",
    "electron",
    "printing",
    "kitchen-printer",
    "webusb-alternative"
  ],
  "main": "dist/main/index.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "npm run build && node scripts/check-layout-sync.js && npm --prefix packages/sdk test",
    "version:bump": "node scripts/bump-version.js",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w",
    "start": "electron .",
    "dev:start": "concurrently -k \"npm:dev\" \"electron .\"",
    "pack": "npm run icon && electron-builder --dir",
    "dist": "npm run icon && electron-builder",
    "icon": "npm run build && node scripts/make-icon.js",
    "dist:win": "npm run icon && electron-builder --win --x64",
    "dist:mac": "npm run icon && electron-builder --mac",
    "dist:win:from-mac": "npm run icon && electron-builder --win --x64 -c.win.signAndEditExecutable=false",
    "release:win": "npm run icon && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.10",
    "express": "^4.22.3",
    "node-thermal-printer": "^4.4.4",
    "qrcode": "^1.5.4",
    "receiptline": "^4.0.4",
    "serialport": "^12.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.2.5",
    "electron": "^44.9.3",
    "electron-builder": "^26.17.0",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.local.pos-hardware-bridge",
    "productName": "POS Hardware Bridge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "docs/*.html",
      "docs/*.yaml",
      "!dist/**/*.map"
    ],
    "icon": "build/icon.png",
    "artifactName": "POS-Hardware-Bridge-Setup-${version}.${ext}",
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "artifactName": "POS-Hardware-Bridge-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POS Hardware Bridge",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Thisarahetz",
        "repo": "pos-hardware-bridge",
        "releaseType": "release"
      }
    ]
  },
  "author": {
    "name": "Thisara Hettikankanam"
  }
}
