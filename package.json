{
  "name": "pos-hardware-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop tray app exposing a local HTTP/WebSocket API for receipt printers and payment terminals, for use by any browser-based POS (GlowDesk, SmartPOS, Restaurant POS, etc.)",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w",
    "start": "electron .",
    "dev:start": "concurrently -k \"npm:dev\" \"electron .\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "express": "^4.21.2",
    "node-thermal-printer": "^4.4.4",
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.local.pos-hardware-bridge",
    "productName": "POS Hardware Bridge",
    "files": ["dist/**/*", "src/renderer/**/*"],
    "mac": { "category": "public.app-category.business" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
